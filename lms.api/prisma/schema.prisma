generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  name       String?
  image      String?
  role       String    @default("student")
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  Assets   Assets[]

  // Classes where this user is the teacher
  classesTeaching  Class[]        @relation("TeacherClasses")
  // Class enrollments when this user is a student
  classEnrollments ClassStudent[]
  tests            Test[]
  submissions      Submission[]
  questions        Question[]
  answers          Answer[]
  quizzes          Quiz[]
  assetsTags       AssetsTag[]

  classTags ClassTags[]

  profile Profile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id        String  @id @default(uuid())
  firstName String?
  lastName  String?
  address   String?
  phone     String?
  bio       String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AssetsTag {
  id   String @id @default(nanoid())
  name String

  assets Assets[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name], name: "user_tag_unique")
}

model Assets {
  id String @id @default(uuid())

  name String @default("")

  fileType String
  filename String
  mimetype String
  fileSize Int // in bytes
  url      String
  type     String

  assetsTags AssetsTag[]

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonId String?

  test   Test?   @relation(fields: [testId], references: [id], onDelete: SetNull)
  testId String?

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  quizId String?
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)

  // Associated with an essay question (question images)
  essayQuestionId String?
  essayQuestion   EssayQuestion? @relation(fields: [essayQuestionId], references: [id], onDelete: SetNull)

  bannerClassId String?
  bannerClass   Class?  @relation(fields: [bannerClassId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, lessonId, testId, submissionId, quizId, essayQuestionId])
  @@index([filename, url])
  @@index([name])
}

// Essay question for essay-type tests.
model EssayQuestion {
  id     String  @id @default(uuid())
  prompt String?

  displayOrder Int @default(1)

  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  assets Assets[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testId])
}

model ClassTags {
  id   String @id @default(nanoid())
  name String

  classes Class[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name], name: "user_classtag_unique")
}

model Class {
  id          String  @id @default(uuid())
  name        String
  description String?
  code        String  @unique

  banners Assets[]

  // One teacher per class
  teacherId String
  teacher   User   @relation("TeacherClasses", fields: [teacherId], references: [id])

  tags ClassTags[]

  // Many students via explicit join table
  students ClassStudent[]
  chapters Chapter[]
  tests    Test[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
}

// Explicit many-to-many join between Class and User (students)
model ClassStudent {
  classId   String
  studentId String

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt  DateTime         @default(now())
  status     EnrollmentStatus @default(pending)
  approvedAt DateTime?

  @@id([classId, studentId])
  @@index([studentId])
}

enum EnrollmentStatus {
  pending
  approved
}

// Type of test
enum TestType {
  essay
  mcq
}

model Chapter {
  id      String  @id @default(uuid())
  title   String
  content String?

  displayOrder Int @default(1)

  classId String
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

model Lesson {
  id      String  @id @default(uuid())
  title   String
  content String?

  displayOrder Int @default(1)

  scheduleDate DateTime?

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  assets Assets[]

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
}

model Question {
  id      String @id @default(uuid())
  title   String
  content String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  Answer Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
}

model Answer {
  id      String @id @default(uuid())
  content String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model Test {
  id   String @id @default(uuid())
  name String

  // test type: essay or mcq
  type TestType @default(mcq)

  userCreatedId String
  userCreated   User   @relation(fields: [userCreatedId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  startDate DateTime?
  endDate   DateTime?

  assets      Assets[]
  submissions Submission[]

  // Quizzes included in this test
  testQuizzes TestQuiz[]

  // Essay questions for essay-type tests
  essayQuestions EssayQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

model Submission {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  assets Assets[]

  score    Float?
  feedback String?

  // MCQ answers for quizzes in the test
  answers SubmissionAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Student selected answer for a quiz inside a submission
model SubmissionAnswer {
  id String @id @default(uuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  choiceId String?
  choice   Choice? @relation(fields: [choiceId], references: [id], onDelete: SetNull)

  isCorrect Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, quizId])
  @@index([quizId])
  @@index([choiceId])
}

model QuizTags {
  id   String @id @default(uuid())
  name String @unique

  quizzes Quiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quiz {
  id      String  @id @default(uuid())
  title   String
  content String?

  assets Assets[]

  choices Choice[]

  // Back relation for submission answers (MCQ submissions)
  submissionAnswers SubmissionAnswer[]

  // Single correct choice for this quiz
  correctChoiceId String? @unique
  correctChoice   Choice? @relation("QuizCorrectChoice", fields: [correctChoiceId], references: [id], onDelete: SetNull)

  tags QuizTags[]

  // Back relation to tests via TestQuiz
  testQuizzes TestQuiz[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Choice {
  id      String @id @default(uuid())
  content String
  // Belongs to a quiz
  quizId  String
  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  // Back relation for the unique correct choice
  correctForQuiz Quiz? @relation("QuizCorrectChoice")

  // Back relation for selections in submissions
  chosenBy SubmissionAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
}

// Join table linking tests and quizzes (many-to-many)
model TestQuiz {
  testId String
  quizId String

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  displayOrder Int    @default(1)
  points       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([testId, quizId])
  @@index([quizId])
}
